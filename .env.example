# =============================================
# Auto Post Facebook - Environment Configuration
# =============================================

# Server
NODE_ENV=development
PORT=3000
API_URL=http://localhost:3000
CLIENT_URL=http://localhost:5173

# Database (MariaDB)
DATABASE_URL="mysql://autopost:autopost_secret@localhost:3310/autopost_db"

# Redis (local docker). On hosting, set REDIS_URL instead (takes precedence):
# REDIS_URL=redis://default:password@host:port   (rediss:// for TLS)
REDIS_HOST=localhost
REDIS_PORT=6381
REDIS_PASSWORD=

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# Facebook OAuth & Graph API
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret
FACEBOOK_REDIRECT_URI=http://localhost:3000/api/auth/facebook/callback

# Google Gemini AI
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash

# Cloudflare Workers AI (Image Generation)
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-2-dev

# Email (SMTP / Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM="Auto Post <noreply@autopost.vn>"

# Production only (see docs/DEPLOY_HOSTINGER.md)
# BASIC_AUTH_USER=admin            # site-wide password prompt, required when the app is on the internet
# BASIC_AUTH_PASS=
# STORAGE_DIR=/home/uXXXXXXXXX/autopost-storage   # images outside the app folder, survives redeploys

# Encryption key for secrets stored in DB (AES-256-GCM)
ENCRYPTION_KEY=   # 32 bytes base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"

# Seed script (seed_page.ts) - connect a page manually for local dev
SEED_FB_PAGE_ID=
SEED_FB_PAGE_NAME=
SEED_FB_PAGE_TOKEN=
