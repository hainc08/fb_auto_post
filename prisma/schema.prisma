// =============================================
// Auto Post Facebook - Database Schema
// =============================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─── Enums ──────────────────────────────────────

enum SubscriptionPlan {
  FREE
  PRO
  BUSINESS
  ENTERPRISE
}

enum UserRole {
  ADMIN
  USER
}

/// Target length of a post format: SHORT 80–120 · MEDIUM 150–250 · LONG 300–450 words
enum FormatLength {
  SHORT
  MEDIUM
  LONG
}

/// How a post's video is published: a normal Page video post or a Reel
enum VideoKind {
  FEED
  REEL
}

enum PostStatus {
  DRAFT
  GENERATING
  READY
  SCHEDULED
  PUBLISHING
  PUBLISHED
  FAILED
}

enum PostMode {
  PREVIEW
  PUBLISH_NOW
}

enum StepStatus {
  RUNNING
  SUCCESS
  FAILED
  SKIPPED
}

enum ScheduleFrequency {
  ONCE
  DAILY
  WEEKLY
  MONTHLY
  CUSTOM_CRON // legacy, no longer accepted by the API
  SLOTS // weekdays + times of day (Phase 2); every schedule is converted to this
}

enum IdeaStatus {
  QUEUED
  USED
}

enum TokenStatus {
  UNCHECKED
  VALID
  OTHER_APP
  EXPIRED
  REVOKED
  MISSING_PERMISSIONS
  ERROR // could not check (network, Facebook down)
}

enum TargetStatus {
  PENDING
  PUBLISHING
  PUBLISHED
  FAILED
}

enum JobStatus {
  PENDING
  RUNNING
  DONE
  FAILED
}

// ─── User & Authentication ──────────────────────

model User {
  id            String  @id @default(uuid())
  email         String  @unique
  passwordHash  String?
  name          String
  avatar        String? @db.Text
  isActive      Boolean @default(true)
  emailVerified Boolean @default(false)

  // Access
  role         UserRole @default(USER)
  /// Bumped when the account is disabled or an admin changes its password / email / role => every session ends
  tokenVersion Int      @default(0)

  // Subscription
  plan          SubscriptionPlan @default(FREE)
  planExpiresAt DateTime?

  // Facebook OAuth (optional - user can also connect pages separately)
  facebookUserId   String?   @unique
  facebookToken    String?   @db.Text
  facebookTokenExp DateTime?

  // Timestamps
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  lastLoginAt DateTime?

  // Relations
  pages     FacebookPage[]
  templates ContentTemplate[]
  posts     Post[]
  schedules PostSchedule[]
  apiKeys   ApiKey[]
  settings  Setting[]
  domains   ContentDomain[]

  @@map("users")
}

model ApiKey {
  id        String    @id @default(uuid())
  userId    String
  key       String    @unique
  name      String
  isActive  Boolean   @default(true)
  lastUsed  DateTime?
  expiresAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("api_keys")
}

// ─── Settings ───────────────────────────────────

model Setting {
  id        String   @id @default(uuid())
  userId    String
  key       String
  value     String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@map("settings")
}

// ─── Facebook Pages ─────────────────────────────

model FacebookPage {
  id              String  @id @default(uuid())
  userId          String
  pageId          String // Facebook Page ID
  pageName        String
  pageAccessToken String  @db.Text // Encrypted
  pageCategory    String?
  pageAvatar      String? @db.Text
  isActive        Boolean @default(true)

  // Token health (see src/lib/page-health.ts). A Page is postable only with a
  // valid token issued by the App ID currently in Settings.
  tokenAppId     String? // Facebook App that issued pageAccessToken
  tokenStatus    TokenStatus @default(UNCHECKED)
  tokenExpiresAt DateTime?
  missingScopes  Json? // string[]
  grantedScopes  Json? // string[] — token scopes at the last check (optional comment scopes live here)
  tokenCheckedAt DateTime?
  tokenError     String?     @db.Text

  /// Domain preselected when creating a post for this Page
  defaultDomainId String?

  /// "AI soạn trả lời bình luận": the sync writes a reply draft for each new comment (src/services/reply-drafts.ts)
  autoReply Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  posts         Post[]
  schedules     PostSchedule[]
  targets       PostTarget[]
  schedulePages SchedulePage[]
  defaultDomain ContentDomain? @relation(fields: [defaultDomainId], references: [id], onDelete: SetNull)

  @@unique([userId, pageId])
  @@map("facebook_pages")
}

// ─── Content Templates ──────────────────────────

model ContentTemplate {
  id          String  @id @default(uuid())
  userId      String
  name        String
  description String?

  // Template content
  promptTemplate String  @db.Text // Prompt template for AI (with {{variables}})
  imagePrompt    String? @db.Text // Image generation prompt template
  hashtags       Json? // Default hashtags (string[])
  category       String? // Content category (product, promo, tips, etc.)

  // Variables schema (JSON)
  variables Json? // e.g., [{"name": "product", "type": "string", "required": true}]

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  posts Post[]

  @@map("content_templates")
}

// ─── Posts ───────────────────────────────────────

model Post {
  id         String  @id @default(uuid())
  userId     String
  pageId     String
  templateId String?
  domainId   String?
  formatId   String?

  // Input (Create Post form)
  topic      String?  @db.VarChar(500)
  tone       String? // friendly | professional | humorous
  language   String   @default("vi")
  extraNotes String?  @db.Text
  mode       PostMode @default(PREVIEW)

  // Content
  caption      String?    @db.Text // Caption as generated by AI (without hashtags)
  message      String?    @db.Text // Final text to publish (caption + hashtags), user-editable
  imagePath    String? // storage/images/{postId}.jpg
  imageUrl     String?    @db.Text // Generated/uploaded image URL
  imagePrompt  String?    @db.Text // Prompt used to generate image
  // Video uploaded from the user's computer (a post has an image OR a video)
  videoPath    String? // storage/videos/{postId}-{ts}.mp4
  videoUrl     String?    @db.Text // /api/videos/{postId}?v=…
  videoMime    String?
  videoMeta    Json? // { durationSec, width, height, bytes }
  videoKind    VideoKind?
  hashtags     Json? // Applied hashtags (string[])
  callToAction String? // CTA text

  // AI Generation metadata
  aiPrompt   String? @db.Text // The actual prompt sent to AI
  aiResponse String? @db.Text // Raw AI response

  // Facebook response
  fbPostId    String? // Facebook post ID after publishing
  fbPhotoId   String? // Facebook photo ID
  fbPermalink String? @db.Text // Permalink to the post

  // Status
  status       PostStatus @default(DRAFT)
  errorMessage String?    @db.Text
  errorStep    String? // Pipeline step that failed
  errorCode    String? // Upstream error code / fbtrace_id
  publishedAt  DateTime?
  scheduledAt  DateTime?

  // Posts written ahead by a slot schedule (scheduledAt = the slot it holds)
  scheduleId     String?
  scheduleQueued Boolean   @default(false) // still holds a slot of its schedule
  approvedAt     DateTime? // approved for its slot (status SCHEDULED)

  // Input variables (JSON) - data used to fill template
  inputData Json?
  // "Tạo Reel từ bài": { voice, scenes: [{ id, text, imagePrompt, image }] } (src/lib/reel/scenes.ts)
  reelDraft Json?
  /// This post is left out of its Pages' AI reply drafts
  autoReplyOff Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  page     FacebookPage     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  template ContentTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  domain   ContentDomain?   @relation(fields: [domainId], references: [id], onDelete: SetNull)
  format   ContentFormat?   @relation(fields: [formatId], references: [id], onDelete: SetNull)
  schedule PostSchedule?    @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  logs     PostLog[]
  steps    PostStep[]
  targets  PostTarget[]

  @@index([userId, status])
  @@index([scheduledAt])
  @@index([scheduleId, scheduleQueued])
  @@map("posts")
}

model PostLog {
  id        String   @id @default(uuid())
  postId    String
  action    String // e.g., "created", "ai_generated", "image_generated", "published", "failed"
  details   Json? // Additional details
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
  @@map("post_logs")
}

model PostStep {
  id              String     @id @default(uuid())
  postId          String
  name            String // generate_content | compose_fields | generate_image | save_image | publish_facebook | check_result
  status          StepStatus
  startedAt       DateTime   @default(now())
  finishedAt      DateTime?
  durationMs      Int?
  requestSummary  Json? // Never contains tokens or image base64
  responseSummary Json?
  error           String?    @db.Text

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId, startedAt])
  @@map("post_steps")
}

// ─── Schedules ──────────────────────────────────

model PostSchedule {
  id       String  @id @default(uuid())
  userId   String
  pageId   String
  name     String
  isActive Boolean @default(true)

  // Schedule config
  frequency ScheduleFrequency
  cronExpr  String? // For CUSTOM_CRON
  timezone  String            @default("Asia/Ho_Chi_Minh")
  startDate DateTime
  endDate   DateTime?

  // Content config
  templateId   String?
  domainId     String?
  formatId     String?
  inputData    Json? // Default input data for template
  autoGenImage Boolean @default(true)

  // Slot schedules: 0 = Sunday … 6 = Saturday and "HH:mm" (Vietnam time), 1–3 slots
  weekdays   Json?
  slots      Json?
  /// Posts kept written ahead for the next slots
  bufferSize Int   @default(3)

  // Tracking
  lastRunAt DateTime?
  nextRunAt DateTime?
  totalRuns Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  page   FacebookPage   @relation(fields: [pageId], references: [id], onDelete: Cascade)
  domain ContentDomain? @relation(fields: [domainId], references: [id], onDelete: SetNull)
  format ContentFormat? @relation(fields: [formatId], references: [id], onDelete: SetNull)
  pages  SchedulePage[]
  ideas  ScheduleIdea[]
  posts  Post[]

  @@map("post_schedules")
}

/// Pages a schedule publishes to (post_schedules.pageId = the first one)
model SchedulePage {
  scheduleId String
  pageId     String

  schedule PostSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  page     FacebookPage @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@id([scheduleId, pageId])
  @@map("schedule_pages")
}

/// Ideas a schedule writes posts from, in order
model ScheduleIdea {
  id         String     @id @default(uuid())
  scheduleId String
  text       String     @db.VarChar(500)
  position   Int
  status     IdeaStatus @default(QUEUED)
  postId     String? // post written from this idea
  usedAt     DateTime?
  createdAt  DateTime   @default(now())

  schedule PostSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@index([scheduleId, status, position])
  @@map("schedule_ideas")
}

// ─── Job Queue ──────────────────────────────────
// Background work (publishing, schedules) queued in MariaDB — no Redis needed.
// A worker in the app process claims due rows with an atomic UPDATE … LIMIT 1.

model Job {
  id          String    @id @default(uuid())
  type        String    @db.VarChar(50) // publish_post | run_schedule
  /**
   * Unique for jobs that must exist once (e.g. "schedule:<id>"); null for one-off jobs
   */
  key         String?   @unique @db.VarChar(100)
  payload     Json
  status      JobStatus @default(PENDING)
  runAt       DateTime  @default(now())
  attempts    Int       @default(0)
  maxAttempts Int       @default(3)
  lockToken   String?   @db.VarChar(36)
  lockedAt    DateTime?
  /**
   * Set when the process died while this job was RUNNING
   */
  interrupted Boolean   @default(false)
  lastError   String?   @db.Text
  finishedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, runAt])
  @@index([lockToken])
  @@map("jobs")
}

// ─── Post Targets ───────────────────────────────
// One post (content + image) published to several Pages; each Page has its own
// status, Facebook post id, link and error. Post.status is the aggregate.

model PostTarget {
  id           String       @id @default(uuid())
  postId       String
  pageId       String // FacebookPage.id
  status       TargetStatus @default(PENDING)
  /**
   * When this Page is due (Pages are staggered to avoid spam signals)
   */
  scheduledAt  DateTime?
  fbPostId     String?
  fbPhotoId    String?
  fbPermalink  String?      @db.Text
  errorMessage String?      @db.Text
  errorCode    String?
  publishedAt  DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  // Engagement (hourly sync, src/services/engagement-sync.ts); null = never synced
  reactionCount   Int?
  commentCount    Int?
  shareCount      Int?
  unansweredCount Int       @default(0)
  statsSyncedAt   DateTime?
  commentsError   String?   @db.Text

  post     Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  page     FacebookPage  @relation(fields: [pageId], references: [id], onDelete: Cascade)
  comments PostComment[]

  @@unique([postId, pageId])
  @@index([pageId])
  @@map("post_targets")
}

/// Comments of one published post on one Page (latest 50 top-level + their replies)
model PostComment {
  id          String    @id @default(uuid())
  targetId    String
  fbCommentId String    @unique
  parentFbId  String? // null = top-level
  authorId    String?
  authorName  String?   @db.VarChar(200)
  message     String    @db.Text
  commentedAt DateTime
  fromPage    Boolean   @default(false)
  pageReplied Boolean   @default(false) // top-level: the Page has replied (in the app or on Facebook)
  handledAt   DateTime? // marked "Đã xử lý" without a reply
  draftReply     String?   @db.Text // AI-written reply waiting for the member to send (top-level comments only)
  draftCheckedAt DateTime? // the AI has looked at this comment once (it is never asked again), with or without a draft
  syncedAt    DateTime  @default(now())

  target PostTarget @relation(fields: [targetId], references: [id], onDelete: Cascade)

  @@index([targetId, parentFbId])
  @@map("post_comments")
}

// ─── Content domains & formats (how AI writes, per user) ───

model ContentDomain {
  id              String   @id @default(uuid())
  userId          String
  name            String   @db.VarChar(80)
  description     String?  @db.VarChar(300)
  audience        String?  @db.Text
  voice           String?  @db.Text
  rules           String?  @db.Text
  defaultHashtags Json? // string[] ≤ 10, stored without "#"
  imageStyle      String?  @db.VarChar(500) // English
  reelInstructions String?  @db.Text // how AI writes Reel scripts for this domain; empty = built-in default
  replyInstructions String?  @db.Text // how AI answers comments for this domain; empty = built-in default
  language        String   @default("vi")
  isArchived      Boolean  @default(false)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  formats   ContentFormat[]
  pages     FacebookPage[]
  posts     Post[]
  schedules PostSchedule[]

  @@unique([userId, name])
  @@map("content_domains")
}

model ContentFormat {
  id           String       @id @default(uuid())
  domainId     String
  name         String       @db.VarChar(80)
  instructions String       @db.Text
  example      String?      @db.Text
  length       FormatLength @default(MEDIUM)
  withImage    Boolean      @default(true)
  isDefault    Boolean      @default(false) // exactly one default per domain
  /// "Bài chuẩn" migrated from the old Settings system prompt: used verbatim (buildIdeaPrompt)
  legacyPrompt Boolean      @default(false)
  isArchived   Boolean      @default(false)
  sortOrder    Int          @default(0)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  domain    ContentDomain  @relation(fields: [domainId], references: [id], onDelete: Cascade)
  posts     Post[]
  schedules PostSchedule[]

  @@unique([domainId, name])
  @@map("content_formats")
}
